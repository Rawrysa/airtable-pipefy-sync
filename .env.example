# Airtable
AIRTABLE_TOKEN=your-airtable-personal-access-token
AIRTABLE_SALES_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_SALES_TABLE_ID=tblXXXXXXXXXXXXXX
AIRTABLE_EMPLOYEE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_EMPLOYEE_TABLE_ID=tblXXXXXXXXXXXXXX
AIRTABLE_TEST_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_TEST_TABLE_ID=tblXXXXXXXXXXXXXX

# Webhooks (public HTTPS URL that reaches listener.py, e.g. an ngrok tunnel)
WEBHOOK_BASE_URL=https://your-tunnel.ngrok-free.app
SALES_WEBHOOK_SECRET=
EMPLOYEE_WEBHOOK_SECRET=
TEST_WEBHOOK_SECRET=

# Pipefy
PIPEFY_CLIENT_ID=your-pipefy-client-id
PIPEFY_CLIENT_SECRET=your-pipefy-client-secret
EMPLOYEE_TABLE_ID=your-pipefy-employee-table-id
PROJECTS_TABLE_ID=your-pipefy-projects-table-id

# PostgreSQL
DB_NAME=sync
DB_USER=postgres
DB_PASS=your-db-password
DB_HOST=localhost
